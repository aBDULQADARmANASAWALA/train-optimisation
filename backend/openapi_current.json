{"openapi":"3.1.0","info":{"title":"Railway Optimization System","description":"Production-grade railway schedule optimization and conflict resolution","version":"1.0.0"},"paths":{"/api/v1/health":{"get":{"tags":["railway-control","railway-control"],"summary":"Health Check","description":"Health check endpoint.\n\nReturns status of all services.","operationId":"health_check_api_v1_health_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HealthResponse"}}}}}}},"/api/v1/optimization/run":{"post":{"tags":["railway-control","railway-control"],"summary":"Run Optimization","description":"Trigger one optimization cycle.\n\nExecutes:\n1. Fetch live state\n2. Generate predictions\n3. Run optimizer\n4. Validate and persist\n\nReturns:\n    OptimizationResult with metrics and status","operationId":"run_optimization_api_v1_optimization_run_post","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/OptimizationRunRequest"}}},"required":true},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/OptimizationResult"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/v1/state/live":{"get":{"tags":["railway-control","railway-control"],"summary":"Get Live State","description":"Get current live network state.\n\nReturns:\n    NetworkState with all trains, sections, and real utilization","operationId":"get_live_state_api_v1_state_live_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/NetworkState"}}}}}}},"/api/v1/metrics":{"get":{"tags":["railway-control","railway-control"],"summary":"Get Metrics","description":"Get latest KPI metrics for dashboard.\n\nReads from the database (optimization_logs + train_states) since each\nrequest